<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- Nothing in this repository sets ContinuousIntegrationBuild, so the CI environment variable
         is what actually engages locked mode; without it the lock file is never enforced. -->
    <RestoreLockedMode Condition="'$(ContinuousIntegrationBuild)' == 'true' or '$(CI)' == 'true'">true</RestoreLockedMode>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Restoration.Resources/Restoration.Resources.csproj" />
    <PackageReference Include="SabreTools.Serialization" Version="[3.2.0]" />
    <EmbeddedResource Include="source-manifests/*.json" />
  </ItemGroup>
</Project>
