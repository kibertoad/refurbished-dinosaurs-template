{
  "deniedRoots": ["UserContent/", "analysis/original/", "reference/original/"],
  "deniedFileNamePatterns": ["^hs_err_pid.*\\.log$", "^replay_pid.*\\.log$", "\\.hprof$"],
  "restrictedExtensions": [
    ".666", ".bmp", ".csf", ".cue", ".dat", ".dib", ".exe", ".fnt", ".gob",
    ".gif", ".ico", ".iso", ".jpeg", ".jpg", ".low", ".mid", ".midi", ".mp3",
    ".ogg", ".pal", ".pcc", ".pcx", ".png", ".rat", ".res", ".smk", ".wav"
  ],
  "approvedRestrictedRoots": ["assets/clean-room/", "tests/fixtures/synthetic/"],
  "maximumTrackedFileBytes": 1048576,
  "approvedLargeFiles": [],
  "textSizeRules": [
    {
      "name": "human-maintained documentation",
      "roots": ["spec", "parity", "deviations", "queue", "docs"],
      "files": ["PARITY.md", "README.md", "AGENTS.md"],
      "extensions": [".md"],
      "excludedRoots": ["docs/upstream"],
      "maxLines": 1000
    },
    {
      "name": "operational handover",
      "files": ["docs/HANDOVER.md"],
      "extensions": [".md"],
      "maxLines": 200,
      "maxWords": 800
    }
  ]
}
