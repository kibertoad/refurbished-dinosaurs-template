<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <!-- Keep NuGet auditing enabled, but do not turn an unreachable advisory
         service into a compiler error after dependencies have been restored. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1900</WarningsNotAsErrors>
    <!-- The SDK normally excludes only the configured output roots. A validation or CI build
         that redirects BaseIntermediateOutputPath would otherwise glob generated files left in a
         project's conventional obj directory as source, producing duplicate assembly attributes. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);**/bin/**;**/obj/**</DefaultItemExcludes>
  </PropertyGroup>

  <!-- Validation creates this per-run root outside the checkout. Keeping every project's
       intermediates and binaries there prevents stale or access-controlled local obj files
       from participating in the build. -->
  <PropertyGroup Condition="'$(ValidationArtifactsRoot)' != ''">
    <BaseIntermediateOutputPath>$(ValidationArtifactsRoot)$(MSBuildProjectName)\obj\</BaseIntermediateOutputPath>
    <BaseOutputPath>$(ValidationArtifactsRoot)$(MSBuildProjectName)\bin\</BaseOutputPath>
  </PropertyGroup>
</Project>
