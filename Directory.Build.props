<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <!-- Keep NuGet auditing enabled, but do not turn an unreachable advisory
         service into a compiler error after dependencies have been restored. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1900</WarningsNotAsErrors>
    <!-- The SDK normally excludes only the configured output roots. A validation or CI build
         that redirects BaseIntermediateOutputPath would otherwise glob generated files left in a
         project's conventional obj directory as source, producing duplicate assembly attributes. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);**/bin/**;**/obj/**</DefaultItemExcludes>
    <!-- The RefurbishedDinosaurs.* runtime packages release together and are pinned exactly. Every
         project that references one uses this version, so a bump is one edit and the projects
         that reference each other cannot pin conflicting versions. -->
    <RefurbishedDinosaursVersion>1.4.0</RefurbishedDinosaursVersion>
  </PropertyGroup>
</Project>
