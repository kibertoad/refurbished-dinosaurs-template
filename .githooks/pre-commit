#!/bin/sh
# Runs the node checks of the fast gate (tools/Invoke-NodeChecks.mjs, which
# tools/Invoke-Validation.ps1 also runs) before a commit, so a spec, queue or checker-pin problem
# fails here instead of in CI. The documentation check runs with --no-ksy, so .ksy compilation is
# left to the gate and CI. Enable once per clone with:
#   git config core.hooksPath .githooks
# The checks run on what is being committed: the index (GIT_INDEX_FILE during a partial commit) is
# checked out to a snapshot directory, so unstaged edits and untracked files neither hide a problem
# nor block a clean commit. GIT_DIR and GIT_WORK_TREE keep the checks' git calls (the deleted-ID
# comparison) on this repository.
#
# The snapshot stays in the repository's git directory between commits, with an index of its own,
# and each commit rewrites only the files whose staged content changed. A fresh copy of the whole
# tree made every commit slow on Windows, where the first read of each newly written file is
# scanned: about 80 seconds for 3,500 files. The first commit in a clone still pays that once.
set -e
if ! command -v node >/dev/null 2>&1; then
  echo "pre-commit: node is not on the path, so the checks were skipped; CI runs them." >&2
  exit 0
fi
git_dir=$(git rev-parse --absolute-git-dir)
work_tree=$(git rev-parse --show-toplevel)
snapshot="$git_dir/precommit-snapshot"
snapshot_index="$git_dir/precommit-snapshot.index"
tree=$(git write-tree)
# Brings the snapshot to the staged tree: read-tree updates the files whose entry changed and
# removes those no longer staged, checkout-index restores any file edited in the snapshot, and
# clean drops untracked files. clean leaves ignored files, so it never touches the node_modules
# link; with -x it would remove the link.
update_snapshot() {
  mkdir -p "$snapshot"
  GIT_INDEX_FILE="$snapshot_index" git --work-tree="$snapshot" read-tree --reset -u "$tree" &&
    GIT_INDEX_FILE="$snapshot_index" git --work-tree="$snapshot" diff-files --name-only -z |
      GIT_INDEX_FILE="$snapshot_index" git --work-tree="$snapshot" checkout-index -f -z --stdin &&
    GIT_INDEX_FILE="$snapshot_index" git --work-tree="$snapshot" clean -fdq
}
# A snapshot that cannot be brought up to date, such as one whose index was damaged, is rebuilt.
# rm -rf unlinks a symlink, and Git Bash's rm -rf a junction, without entering it. The link is
# removed first with rm -f, which has no -r and so cannot enter the checkout's packages either way.
if ! update_snapshot; then
  echo "pre-commit: rebuilding the staged snapshot in $snapshot." >&2
  rm -f "$snapshot/node_modules"
  rm -rf "$snapshot" "$snapshot_index"
  update_snapshot
fi
# The snapshot has no installed packages; the checks use the checkout's (pnpm install). Node makes
# the link: a junction on Windows, where Git Bash's ln -s copies the directory instead, and a
# symlink elsewhere.
if [ -d "$work_tree/node_modules" ] && [ ! -e "$snapshot/node_modules" ]; then
  rm -f "$snapshot/node_modules"
  node -e 'require("fs").symlinkSync(process.argv[1], process.argv[2], "junction")' "$work_tree/node_modules" "$snapshot/node_modules"
fi
export GIT_DIR="$git_dir" GIT_WORK_TREE="$snapshot"
node "$snapshot/tools/Invoke-NodeChecks.mjs" --no-ksy
