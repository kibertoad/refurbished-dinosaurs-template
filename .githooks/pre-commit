#!/bin/sh
# Runs the node checks of the fast gate (tools/Invoke-NodeChecks.mjs, which
# tools/Invoke-Validation.ps1 also runs) before a commit, so a spec, queue or reporter-pin problem
# fails here instead of in CI. The documentation check runs with --no-ksy, so .ksy compilation is
# left to the gate and CI. Enable once per clone with:
#   git config core.hooksPath .githooks
# The checks run on what is being committed: the index (GIT_INDEX_FILE during a partial commit) is
# copied to a temporary directory, so unstaged edits and untracked files neither hide a problem
# nor block a clean commit. GIT_DIR and GIT_WORK_TREE keep the checks' git calls (the deleted-ID
# comparison) on this repository.
set -e
if ! command -v node >/dev/null 2>&1; then
  echo "pre-commit: node is not on the path, so the checks were skipped; CI runs them." >&2
  exit 0
fi
git_dir=$(git rev-parse --absolute-git-dir)
# A separate step, so a failed mktemp stops the hook instead of leaving $staged empty.
staged=$(mktemp -d)
trap 'rm -rf "$staged"' EXIT
trap 'exit 1' HUP INT TERM
git checkout-index --all --prefix="$staged/"
export GIT_DIR="$git_dir" GIT_WORK_TREE="$staged"
node "$staged/tools/Invoke-NodeChecks.mjs" --no-ksy
