#!/bin/sh
# Runs the node checks of the fast gate (tools/Invoke-NodeChecks.mjs, which
# tools/Invoke-Validation.ps1 also runs) before a commit, so a spec, queue or checker-pin problem
# fails here instead of in CI. The documentation check runs with --no-ksy, so .ksy compilation is
# left to the gate and CI. Enable once per clone with:
#   git config core.hooksPath .githooks
# The checks run on what is being committed: the index (GIT_INDEX_FILE during a partial commit) is
# checked out to a snapshot directory, so unstaged edits and untracked files neither hide a problem
# nor block a clean commit. GIT_DIR and GIT_WORK_TREE keep the checks' git calls (the deleted-ID
# comparison) on this repository.
#
# The snapshot stays in the repository's git directory between commits, with an index of its own,
# and each commit rewrites only the files whose staged content changed. A fresh copy of the whole
# tree made every commit slow on Windows, where the first read of each newly written file is
# scanned: about 80 seconds for 3,600 files. The first commit in a clone still pays that once.
set -e
if ! command -v node >/dev/null 2>&1; then
  echo "pre-commit: node is not on the path, so the checks were skipped; CI runs them." >&2
  exit 0
fi
git_dir=$(git rev-parse --absolute-git-dir)
work_tree=$(git rev-parse --show-toplevel)
snapshot="$git_dir/precommit-snapshot"
snapshot_index="$git_dir/precommit-snapshot.index"
tree=$(git write-tree)
# The snapshot has no installed packages; the checks use the checkout's (pnpm install) through a
# node_modules link. links names every directory the snapshot links to in the checkout, and any new
# link goes there. The links are removed before the snapshot is updated and made again after, so
# clean can run with -x (which would remove a link even when passed as -e, and could follow one into
# the checkout) and each link always points at this checkout, also in a copy of the repository.
# rm -f has no -r, so it unlinks a symlink, and Git Bash's rm -f a junction, without entering the
# directory it points at.
links="node_modules"
for link in $links; do
  rm -f "$snapshot/$link"
  if [ -e "$snapshot/$link" ] || [ -L "$snapshot/$link" ]; then
    echo "pre-commit: could not remove $snapshot/$link, so the snapshot was left alone." >&2
    exit 1
  fi
done
# Brings the snapshot to the staged tree: read-tree updates the files whose entry changed, removes
# those no longer staged and, with --reset, also rewrites any file edited or deleted in the
# snapshot; clean -x removes every other file there, ignored ones included, so the checks see only
# the staged tree.
update_snapshot() {
  mkdir -p "$snapshot"
  GIT_INDEX_FILE="$snapshot_index" git --work-tree="$snapshot" read-tree --reset -u "$tree" &&
    GIT_INDEX_FILE="$snapshot_index" git --work-tree="$snapshot" clean -fdqx
}
# A snapshot that cannot be brought up to date, such as one whose index was damaged or whose index
# lock a killed run left behind, is rebuilt. git commit holds the repository's index lock while
# this hook runs, so another commit cannot be using the snapshot's lock at the same time.
if ! update_snapshot; then
  echo "pre-commit: rebuilding the staged snapshot in $snapshot." >&2
  rm -rf "$snapshot" "$snapshot_index" "$snapshot_index.lock"
  update_snapshot
fi
# Node makes the links: junctions on Windows, where Git Bash's ln -s copies the directory instead,
# and symlinks elsewhere.
for link in $links; do
  if [ -d "$work_tree/$link" ]; then
    node -e 'require("fs").symlinkSync(process.argv[1], process.argv[2], "junction")' "$work_tree/$link" "$snapshot/$link"
  fi
done
export GIT_DIR="$git_dir" GIT_WORK_TREE="$snapshot"
node "$snapshot/tools/Invoke-NodeChecks.mjs" --no-ksy
