#!/bin/sh
# Runs the node checks of the fast gate (tools/Invoke-NodeChecks.mjs, which
# tools/Invoke-Validation.ps1 also runs) before a commit, so a spec, queue or checker-pin problem
# fails here instead of in CI. The documentation check runs with --no-ksy, so .ksy compilation is
# left to the gate and CI. Enable once per clone with:
#   git config core.hooksPath .githooks
# The checks run on what is being committed: the index (GIT_INDEX_FILE during a partial commit) is
# copied to a temporary directory, so unstaged edits and untracked files neither hide a problem
# nor block a clean commit. GIT_DIR and GIT_WORK_TREE keep the checks' git calls (the deleted-ID
# comparison) on this repository.
set -e
if ! command -v node >/dev/null 2>&1; then
  echo "pre-commit: node is not on the path, so the checks were skipped; CI runs them." >&2
  exit 0
fi
git_dir=$(git rev-parse --absolute-git-dir)
work_tree=$(git rev-parse --show-toplevel)
# A separate step, so a failed mktemp stops the hook instead of leaving $staged empty.
staged=$(mktemp -d)
trap 'rm -rf "$staged"' EXIT
trap 'exit 1' HUP INT TERM
git checkout-index --all --prefix="$staged/"
# The copy has no installed packages; the checks use the checkout's (pnpm install).
if [ -d "$work_tree/node_modules" ]; then
  if ! ln -s "$work_tree/node_modules" "$staged/node_modules" 2>/dev/null; then
    # Git for Windows cannot make a symbolic link without Developer Mode, and its copy fallback
    # fails on pnpm's links. A directory junction needs no privilege, and rm -rf removes only the link.
    command -v cygpath >/dev/null 2>&1 || { echo "pre-commit: could not link node_modules into the staged copy." >&2; exit 1; }
    rm -rf "$staged/node_modules"
    link=$(cygpath -w "$staged/node_modules")
    target=$(cygpath -w "$work_tree/node_modules")
    # Without the exclusion, MSYS rewrites /c and /J as paths before cmd sees them.
    MSYS2_ARG_CONV_EXCL='*' cmd /c mklink /J "$link" "$target" >/dev/null
  fi
fi
export GIT_DIR="$git_dir" GIT_WORK_TREE="$staged"
node "$staged/tools/Invoke-NodeChecks.mjs" --no-ksy
